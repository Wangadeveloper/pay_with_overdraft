# PayPal Sandbox Credentials
# Get these from: https://developer.paypal.com → Apps & Credentials → Create App
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# App Configuration
FLASK_SECRET_KEY=change_me_to_random_string_in_production
PAYPAL_MODE=sandbox

# Demo Mode (set to "true" to use pre-seeded data without PayPal API calls)
DEMO_MODE=false

# Your PayPal sandbox merchant email
PAYPAL_MERCHANT_EMAIL=peterwanga326@gmail.com

# ── PayFlow Funder Pool Account (Business Sandbox) ─────────────────────────────
# This is the business account that FUNDS all overdraft payouts.
# The main PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET above must be credentials of
# a sandbox App created under THIS business account.
PAYPAL_FUNDER_EMAIL=sb-qjdsl53206694@business.example.com

# ── PayFlow Buyer Account (Personal Sandbox) ───────────────────────────────────
# The personal account that RECEIVES overdraft payouts and makes purchases.
PAYPAL_BUYER_EMAIL=sb-tfjr4353268252@personal.example.com
PAYPAL_BUYER_ACCOUNT_ID=RTFSG6HD676ML
PAYPAL_BUYER_NAME=John Doe
PAYPAL_BUYER_INITIAL_BALANCE=5000.00

# ── Buyer App Credentials (for live personal account balance fetching) ─────────
# PayPal's Balances API is account-scoped: to read the PERSONAL account's real
# wallet balance you must authenticate with an App created under that account.
#
# One-time setup:
#   1. Go to developer.paypal.com
#   2. Log in as the SANDBOX PERSONAL account (sb-tfjr4353268252@personal.example.com)
#   3. Apps & Credentials → Create App (sandbox)
#   4. Copy the Client ID and Secret below
#   5. Restart Flask — GET /api/balance/buyer will now return the live balance
#
# Without these, the buyer balance endpoint returns source='buyer_credentials_missing'
# and the DB balance is preserved unchanged.
PAYPAL_BUYER_CLIENT_ID=
PAYPAL_BUYER_CLIENT_SECRET=
