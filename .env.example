# PayPal Sandbox Credentials
# Get these from: https://developer.paypal.com → Apps & Credentials → Create App
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# App Configuration
FLASK_SECRET_KEY=change_me_to_random_string_in_production
PAYPAL_MODE=sandbox

# Demo Mode (set to "true" to use pre-seeded data without PayPal API calls)
DEMO_MODE=false

# Your PayPal sandbox merchant email
PAYPAL_MERCHANT_EMAIL=peterwanga326@gmail.com
